# ── ParaIQ Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to git.

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Must match across pg.py, auth.py, audit_trail.py, main.py
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-32-byte-hex-secret

# ── API Access (REQUIRED) ─────────────────────────────────────────────────────
PARAIQ_API_KEY=pk-replace-with-strong-random-key
PARAIQ_ADMIN_KEY=admin-replace-with-strong-random-key

# ── AI APIs (REQUIRED) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── LLM Model Config (optional — defaults shown) ──────────────────────────────
LLM_FAST=claude-haiku-4-5-20251001
LLM_STRONG=claude-opus-4-5

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.yourproject:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ── CORS (REQUIRED in production) ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.para-iq.com

# ── Email Polling (optional) ──────────────────────────────────────────────────
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REFRESH_TOKEN=your-outlook-refresh-token

# ── Observability (optional) ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ── Vector Store (optional) ───────────────────────────────────────────────────
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=/root/nlp-portfolio/chroma_db
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=paraiq
