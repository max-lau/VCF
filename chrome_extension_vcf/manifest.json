{
  "manifest_version": 3,
  "name": "ACP-VCF Prep Panel",
  "version": "1.0.0",
  "description": "Shows the WAW prep sheet as a side panel on claims.vcf.gov. Copy-paste ready — never fills or submits the VCF form itself.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://www.claims.vcf.gov/*",
    "https://claims.vcf.gov/*",
    "http://localhost:5003/*",
    "http://127.0.0.1:5003/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.claims.vcf.gov/*", "https://claims.vcf.gov/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ACP-VCF settings"
  }
}
